# StudyInk runs an open-weight model. The default keeps everything on this laptop.

# 1. LOCAL (default, most private): Ollama on this computer. Needs a model that can see images
#    (to judge and caption figures) as well as write.
#    ollama pull gemma4:e4b
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=gemma4:e4b

# 2. Any OpenAI-compatible endpoint serving an open vision model (llama.cpp, vLLM, LM Studio).
#    Note: your slides would then go to that host.
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_MODEL=gemma-3-12b-it
# LLM_API_KEY=

# The slide reader (extractor/slides.py): a Python 3.9+ with PyMuPDF, Pillow and python-pptx.
#    pip3 install pymupdf pillow python-pptx
#    brew install --cask libreoffice      (only needed for .pptx; PDFs work without it)
PYTHON=python3
